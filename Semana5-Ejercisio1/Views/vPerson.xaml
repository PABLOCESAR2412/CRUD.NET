<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Semana5_Ejercisio1.Views.vPerson"
             Title="Personas">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Semana 5: BASES DE DATOS LOCALES" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Entry x:Name="NameEntry" Placeholder="Nombre de la persona"/>

        <Button Text="Agregar persona" Clicked="OnAddClicked"/>

        <Button Text="Mostrar persona" Clicked="OnShowClicked"/>

        <Button Text="Borrar" Clicked="OnDeleteClicked"/>

        <Label x:Name="MessageLabel" />

        <CollectionView x:Name="PersonsCollection" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}" Padding="5"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
